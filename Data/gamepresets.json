{
  // In-game config presets. Adding a game = adding an entry here (or a .json file with the same
  // shape in %LocalAppData%\Vanta\GamePresets). Formats: ini, kv, colon, guide.
  // onlyExistingKeys (default true) means a preset never adds keys your file does not already have.
  // These are honest starting points, not lab-tested magic numbers: always check in game.
  "games": [
    {
      "id": "cs2",
      "name": "Counter-Strike 2",
      "format": "kv",
      "paths": [ "{steam}\\userdata\\*\\730\\local\\cfg\\cs2_video.txt" ],
      "notes": "Close CS2 before applying, or it overwrites the file on exit. Competitive players usually keep everything low except texture detail for visibility.",
      "tips": [
        "NVIDIA Reflex (r_low_latency) 'Enabled' lowers input lag when you are GPU-bound; leave Boost off unless you are clearly GPU-limited.",
        "Launch option '-fullscreen' is enough; old CS:GO options like -high or -threads don't help in CS2.",
        "Cap FPS with fps_max a little above your typical lows for steadier frametimes."
      ],
      "presets": {
        "Max FPS": {
          "setting.mat_vsync": "0",
          "setting.msaa_samples": "0",
          "setting.r_csgo_cmaa_enable": "0",
          "setting.shaderquality": "0",
          "setting.r_texturefilteringquality": "0",
          "setting.r_particle_max_detail_level": "0",
          "setting.r_aoproxy_enable": "0",
          "setting.sc_hdr_enabled_override": "3",
          "setting.r_low_latency": "1",
          "setting.cpu_level": "0",
          "setting.gpu_level": "0"
        },
        "Balanced": {
          "setting.mat_vsync": "0",
          "setting.msaa_samples": "2",
          "setting.shaderquality": "0",
          "setting.r_texturefilteringquality": "2",
          "setting.r_aoproxy_enable": "0",
          "setting.r_low_latency": "1",
          "setting.cpu_level": "1",
          "setting.gpu_level": "1"
        },
        "Visual quality": {
          "setting.mat_vsync": "0",
          "setting.msaa_samples": "4",
          "setting.shaderquality": "1",
          "setting.r_texturefilteringquality": "5",
          "setting.r_aoproxy_enable": "1",
          "setting.r_low_latency": "1",
          "setting.cpu_level": "3",
          "setting.gpu_level": "3"
        }
      },
      "presetNotes": {
        "Max FPS": "Lowest settings, MSAA off, HDR set to Performance, Reflex on.",
        "Visual quality": "MSAA 4x, high shaders and anisotropic 16x. Still competitive-friendly."
      }
    },
    {
      "id": "fortnite",
      "name": "Fortnite",
      "format": "ini",
      "paths": [ "%LOCALAPPDATA%\\FortniteGame\\Saved\\Config\\WindowsClient\\GameUserSettings.ini" ],
      "notes": "Close Fortnite first. For the biggest jump, switch Rendering Mode to 'Performance' in game (that is a separate DX11 low-end renderer).",
      "tips": [
        "Performance rendering mode can more than double FPS on mid-range PCs at the cost of visuals.",
        "Turn on NVIDIA Reflex 'On + Boost' in game if you are GPU-bound.",
        "If you set the file read-only to stop Fortnite overwriting it, Vanta keeps that attribute."
      ],
      "presets": {
        "Max FPS": {
          "ScalabilityGroups/sg.ResolutionQuality": "100",
          "ScalabilityGroups/sg.ViewDistanceQuality": "1",
          "ScalabilityGroups/sg.AntiAliasingQuality": "0",
          "ScalabilityGroups/sg.ShadowQuality": "0",
          "ScalabilityGroups/sg.GlobalIlluminationQuality": "0",
          "ScalabilityGroups/sg.ReflectionQuality": "0",
          "ScalabilityGroups/sg.PostProcessQuality": "0",
          "ScalabilityGroups/sg.TextureQuality": "1",
          "ScalabilityGroups/sg.EffectsQuality": "0",
          "ScalabilityGroups/sg.FoliageQuality": "0",
          "ScalabilityGroups/sg.ShadingQuality": "0",
          "/Script/FortniteGame.FortGameUserSettings/bUseVSync": "False",
          "/Script/FortniteGame.FortGameUserSettings/bMotionBlur": "False",
          "/Script/FortniteGame.FortGameUserSettings/bShowGrass": "False"
        },
        "Balanced": {
          "ScalabilityGroups/sg.ResolutionQuality": "100",
          "ScalabilityGroups/sg.ViewDistanceQuality": "2",
          "ScalabilityGroups/sg.AntiAliasingQuality": "1",
          "ScalabilityGroups/sg.ShadowQuality": "1",
          "ScalabilityGroups/sg.GlobalIlluminationQuality": "1",
          "ScalabilityGroups/sg.ReflectionQuality": "1",
          "ScalabilityGroups/sg.PostProcessQuality": "1",
          "ScalabilityGroups/sg.TextureQuality": "2",
          "ScalabilityGroups/sg.EffectsQuality": "1",
          "ScalabilityGroups/sg.FoliageQuality": "1",
          "ScalabilityGroups/sg.ShadingQuality": "1",
          "/Script/FortniteGame.FortGameUserSettings/bUseVSync": "False",
          "/Script/FortniteGame.FortGameUserSettings/bMotionBlur": "False"
        },
        "Visual quality": {
          "ScalabilityGroups/sg.ResolutionQuality": "100",
          "ScalabilityGroups/sg.ViewDistanceQuality": "3",
          "ScalabilityGroups/sg.AntiAliasingQuality": "3",
          "ScalabilityGroups/sg.ShadowQuality": "3",
          "ScalabilityGroups/sg.GlobalIlluminationQuality": "3",
          "ScalabilityGroups/sg.ReflectionQuality": "3",
          "ScalabilityGroups/sg.PostProcessQuality": "3",
          "ScalabilityGroups/sg.TextureQuality": "3",
          "ScalabilityGroups/sg.EffectsQuality": "3",
          "ScalabilityGroups/sg.FoliageQuality": "3",
          "ScalabilityGroups/sg.ShadingQuality": "3"
        }
      }
    },
    {
      "id": "apex",
      "name": "Apex Legends",
      "format": "kv",
      "paths": [ "{savedgames}\\Respawn\\Apex\\local\\videoconfig.txt" ],
      "notes": "Close Apex first. Apex caps at 144 FPS by default unless you add '+fps_max 0' (or your cap) to the launch options.",
      "tips": [ "Launch option '+fps_max 0' removes the default cap; '+fps_max 237' suits a 240 Hz VRR monitor." ],
      "presets": {
        "Max FPS": {
          "setting.mat_vsync_mode": "0",
          "setting.mat_antialias_mode": "0",
          "setting.csm_enabled": "0",
          "setting.shadow_enable": "0",
          "setting.ssao_enabled": "0",
          "setting.volumetric_lighting": "0",
          "setting.r_lod_switch_scale": "0.6",
          "setting.particle_cpu_level": "0",
          "setting.r_decals": "0",
          "setting.mat_depthfeather_enable": "0",
          "setting.dvs_enable": "0"
        },
        "Balanced": {
          "setting.mat_vsync_mode": "0",
          "setting.mat_antialias_mode": "12",
          "setting.csm_enabled": "1",
          "setting.shadow_enable": "1",
          "setting.ssao_enabled": "0",
          "setting.volumetric_lighting": "0",
          "setting.r_lod_switch_scale": "1",
          "setting.particle_cpu_level": "1"
        },
        "Visual quality": {
          "setting.mat_vsync_mode": "0",
