    {
      "id": "valorant",
      "name": "VALORANT",
      "format": "guide",
      "notes": "VALORANT stores video settings on your Riot account and re-downloads them, so Vanta does not edit its files. Vanguard is a kernel anti-cheat: Vanta only uses normal Windows APIs and never touches the game process beyond priority if Windows allows it.",
      "tips": [
        "Low/Off for Material, Texture, Detail, UI quality; Vignette off; Anti-aliasing MSAA 2x or None; Anisotropic 4x.",
        "NVIDIA Reflex: 'On + Boost' if GPU-bound.",
        "Multithreaded rendering: On (helps nearly every modern CPU).",
        "VALORANT is usually CPU-bound: RAM speed (XMP/EXPO) matters more than GPU settings."
      ]
    },
    {
      "id": "warzone",
      "name": "Call of Duty: Warzone / Black Ops / MW",
      "format": "guide",
      "notes": "Call of Duty keeps settings in a binary-ish options file that changes with every season, so Vanta gives guidance instead of editing it. Ricochet is a kernel anti-cheat; Vanta does not touch the game process beyond what Windows allows.",
      "tips": [
        "Use DLSS/FSR Quality (or Balanced at 1440p+) for the biggest FPS gain.",
        "Lower shadow map resolution, volumetric quality, and screen-space reflections first.",
        "Set 'VRAM Scale Target' to about 80-90% to avoid VRAM stutter.",
        "On-demand texture streaming can cause stutter on slow connections; turn it off if so."
      ]
    },
    {
      "id": "overwatch2",
      "name": "Overwatch 2",
      "format": "guide",
      "notes": "Overwatch 2's Settings_v0.ini is rewritten and partly synced by Battle.net, so editing it is unreliable. Use these in-game settings instead.",
      "tips": [
        "Render scale 100% (or Custom with FSR 2 for more FPS), Texture Quality Medium, everything else Low.",
        "NVIDIA Reflex: 'Enabled + Boost'. Reduce Buffering: On.",
        "Cap FPS a little below your typical minimum for consistent aim."
      ]
    },
    {
      "id": "roblox",
      "name": "Roblox",
      "format": "guide",
      "notes": "Roblox's graphics quality is a slider in the in-game menu. Third-party FPS unlockers and 'FastFlags' tools modify the client; avoid them since they can break Roblox's terms of use. Roblox now offers a built-in max frame rate option in settings.",
      "tips": [
        "Set Graphics Mode to Manual and lower the slider until FPS is stable.",
        "Use the built-in 'Maximum Frame Rate' option instead of unlockers."
      ]
    },
    {
      "id": "gta5",
      "name": "Grand Theft Auto V",
      "format": "guide",
      "notes": "GTA V's settings.xml is easy to break and the game resets it on version changes; use the in-game menu (Enhanced edition supports DLSS/FSR).",
      "tips": [
        "Biggest FPS hitters: MSAA, grass quality, shadow quality, and 'Extended distance scaling'.",
        "Keep Population Density/Variety moderate on 4-6 core CPUs."
      ]
    },
    {
      "id": "cyberpunk",
      "name": "Cyberpunk 2077",
      "format": "guide",
      "notes": "Settings live in a large UserSettings.json that changes with patches; use the in-game presets.",
      "tips": [
        "Path tracing/ray tracing are the biggest hit; DLSS/FSR with Frame Generation if your GPU supports it.",
        "Crowd density 'Low' helps a lot when CPU-bound.",
        "Install on an SSD; the game is designed for SSD streaming."
      ]
    },
    {
      "id": "eldenring",
      "name": "Elden Ring",
      "format": "guide",
      "notes": "Elden Ring is capped at 60 FPS by design. Removing the cap needs mods that disable online play (Easy Anti-Cheat); Vanta does not do that.",
      "tips": [
        "If you stutter, it is mostly shader compilation on first visits; it improves as the shader cache fills. Don't clear the shader cache.",
        "Set the in-game 'Auto-detect best rendering settings' off and lower Shadow and Grass quality first."
      ]
    }
  ]
}
