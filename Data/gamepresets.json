    {
      "id": "minecraft-java",
      "name": "Minecraft: Java Edition",
      "format": "colon",
      "paths": [ "%APPDATA%\\.minecraft\\options.txt" ],
      "notes": "Close Minecraft first. The biggest FPS gain by far comes from performance mods, not settings (see tips).",
      "tips": [
        "Install Fabric with Sodium (rendering), Lithium (game logic) and FerriteCore (memory). Sodium alone often gives 2-3x FPS.",
        "Iris adds shader support on top of Sodium if you want shaders.",
        "Recommended JVM args for 16 GB+ PCs: -Xms4G -Xmx4G -XX:+UseG1GC -XX:MaxGCPauseMillis=50. Giving Minecraft more than 6-8 GB usually hurts (longer garbage-collection pauses) unless you run big modpacks.",
        "Use the Java version the launcher bundles; don't install an old system Java."
      ],
      "presets": {
        "Max FPS": {
          "renderDistance": "8",
          "simulationDistance": "6",
          "graphicsMode": "0",
          "maxFps": "260",
          "enableVsync": "false",
          "entityShadows": "false",
          "particles": "2",
          "ao": "false",
          "biomeBlendRadius": "0",
          "mipmapLevels": "0",
          "renderClouds": "\"false\"",
          "entityDistanceScaling": "0.5"
        },
        "Balanced": {
          "renderDistance": "12",
          "simulationDistance": "8",
          "graphicsMode": "0",
          "maxFps": "260",
          "enableVsync": "false",
          "entityShadows": "true",
          "particles": "1",
          "ao": "true",
          "biomeBlendRadius": "2",
          "renderClouds": "\"fast\""
        },
        "Visual quality": {
          "renderDistance": "16",
          "simulationDistance": "10",
          "graphicsMode": "1",
          "enableVsync": "false",
          "entityShadows": "true",
          "particles": "0",
          "ao": "true",
          "biomeBlendRadius": "4",
          "mipmapLevels": "4",
          "renderClouds": "\"true\""
        }
      },
      "presetNotes": { "Max FPS": "maxFps 260 means 'Unlimited' in the video settings slider." }
    },
    {
      "id": "rocket-league",
      "name": "Rocket League",
      "format": "ini",
      "paths": [ "{documents}\\My Games\\Rocket League\\TAGame\\Config\\TASystemSettings.ini" ],
