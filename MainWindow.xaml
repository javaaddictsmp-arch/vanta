<Window x:Class="TuneUp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vanta" Icon="Assets/vanta.ico"
        Width="1360" Height="860" MinWidth="1100" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" FontSize="13"
        TextOptions.TextFormattingMode="Display">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Ambient glow behind the page (decorative) -->
        <Canvas Grid.Column="1" IsHitTestVisible="False" ClipToBounds="True">
            <Ellipse Width="760" Height="760" Canvas.Right="-300" Canvas.Top="-420">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#307C5CFF" Offset="0"/>
                        <GradientStop Color="#007C5CFF" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Ellipse Width="620" Height="620" Canvas.Left="-260" Canvas.Bottom="-380">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#1A22D3EE" Offset="0"/>
                        <GradientStop Color="#0022D3EE" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
        </Canvas>

        <!-- Sidebar -->
        <Border Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
            <DockPanel>
                <!-- Logo -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="22,26,22,24">
                    <Border Width="40" Height="40" CornerRadius="11" Background="#1A1533">
                        <Border.Effect>
                            <DropShadowEffect Color="#7C5CFF" BlurRadius="18" ShadowDepth="0" Opacity="0.45"/>
                        </Border.Effect>
                        <!-- The logo glow slowly "breathes". -->
                        <Border.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Opacity)" From="0.25" To="0.75" Duration="0:0:2.6">
                                            <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.BlurRadius)" From="14" To="24" Duration="0:0:2.6">
                                            <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Border.Triggers>
                        <Image Source="{StaticResource VantaMark}" Width="30" Height="30"/>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Vanta" FontSize="22" FontWeight="Bold" Foreground="{StaticResource BrandGradientBrush}"/>
                        <TextBlock Text="Honest PC tuning" Style="{StaticResource MutedText}" FontSize="11.5" Margin="0,-2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Footer: admin status + version -->
                <StackPanel DockPanel.Dock="Bottom" Margin="22,10,22,18">
                    <Button Command="{Binding OpenUpdateCommand}" Margin="0,0,0,8" Padding="10,8" HorizontalContentAlignment="Left" Cursor="Hand"
                            Style="{StaticResource AccentButton}" ToolTip="Opens the download page in your browser"
                            Visibility="{Binding UpdateAvailable, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding UpdateText}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Border CornerRadius="10" Padding="10,7" Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource LineBrush}" BorderThickness="1" ToolTip="{Binding FooterText}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource WarnBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsAdminMode}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource GoodBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding StatusPill}" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="{Binding VersionText}" Style="{StaticResource MutedText}" FontSize="11" Margin="2,8,0,0"/>
                </StackPanel>

                <!-- Navigation -->
                <ListBox ItemsSource="{Binding VisibleNavItems}" SelectedItem="{Binding SelectedNav}"
                         Background="Transparent" BorderThickness="0"
                         ItemContainerStyle="{StaticResource NavItemStyle}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel LastChildFill="True">
                                <TextBlock DockPanel.Dock="Left" Text="{Binding Glyph}"
                                           FontFamily="Segoe MDL2 Assets" FontSize="16" Width="28" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <Border DockPanel.Dock="Right" Style="{StaticResource Chip}" Margin="0" Padding="7,1"
                                        Background="{StaticResource Surface2Brush}"
                                        Visibility="{Binding PhaseTag, Converter={StaticResource StringToVis}}">
                                    <TextBlock Text="{Binding PhaseTag}" FontSize="10" Foreground="{StaticResource MutedBrush}"/>
                                </Border>
                                <TextBlock Text="{Binding Title}" VerticalAlignment="Center" FontSize="13.5"/>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Page -->
        <ContentControl Grid.Column="1" Content="{Binding CurrentViewModel}"/>

        <!-- First-run setup (also from Settings > Run setup again) -->
        <Grid Grid.ColumnSpan="2" DataContext="{Binding Wizard}" Background="#D8070910"
              Visibility="{Binding IsOpen, Converter={StaticResource BoolToVis}}">
            <Border Width="680" MaxHeight="760" VerticalAlignment="Center" HorizontalAlignment="Center" CornerRadius="18" Padding="34,30"
                    Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource CardHoverEdgeBrush}" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect Color="#7C5CFF" BlurRadius="60" ShadowDepth="0" Opacity="0.35"/>
                </Border.Effect>
                <DockPanel>
                    <!-- Header: logo + step dots -->
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,22">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="26" Height="6" CornerRadius="3" Margin="3,0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource AccentGradientBrush}"/>
                                    </Style>
                                </Border.Style>
                            </Border>
                            <Border Width="26" Height="6" CornerRadius="3" Margin="3,0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{StaticResource Surface2Brush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsStep0}" Value="False">
                                                <Setter Property="Background" Value="{DynamicResource AccentGradientBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                            <Border Width="26" Height="6" CornerRadius="3" Margin="3,0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{StaticResource Surface2Brush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsStep2}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource AccentGradientBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Image Source="{StaticResource VantaMark}" Width="30" Height="30"/>
                            <TextBlock Text="Vanta setup" FontSize="18" FontWeight="Bold" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- Footer buttons -->
                    <DockPanel DockPanel.Dock="Bottom" Margin="0,24,0,0">
                        <Button DockPanel.Dock="Left" Content="Skip setup" Style="{StaticResource LinkButton}" Command="{Binding SkipCommand}" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Back" Command="{Binding BackCommand}" Margin="0,0,10,0" MinWidth="90"
                                    Visibility="{Binding CanGoBack, Converter={StaticResource BoolToVis}}"/>
                            <Button Content="{Binding NextText}" Style="{StaticResource HeroButton}" Command="{Binding NextCommand}" MinWidth="130"/>
                        </StackPanel>
                    </DockPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Grid>
                            <!-- Step 1: welcome + mode -->
                            <StackPanel Visibility="{Binding IsStep0, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Welcome to Vanta" Style="{StaticResource H1}"/>
                                <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,8,0,18" FontSize="13.5"
                                           Text="Vanta makes games run smoother and keeps your PC tidy, and it can undo anything it changes. First, how much do you want to see?"/>
                                <RadioButton GroupName="mode" IsChecked="{Binding Simple}" Margin="0,0,0,10">
                                    <StackPanel Margin="4,0,0,0">
                                        <TextBlock Text="Simple" FontWeight="SemiBold" FontSize="15"/>
                                        <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,2,0,0" MaxWidth="560" HorizontalAlignment="Left"
                                                   Text="Just the essentials: game boost, cleaning, startup apps and ping. Best if you don't want to think about it."/>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton GroupName="mode" IsChecked="{Binding IsFull}">
                                    <StackPanel Margin="4,0,0,0">
                                        <TextBlock Text="Full" FontWeight="SemiBold" FontSize="15"/>
                                        <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,2,0,0" MaxWidth="560" HorizontalAlignment="Left"
                                                   Text="Everything, including individual tweaks, live monitoring, timer and latency tools, services and privacy settings."/>
                                    </StackPanel>
                                </RadioButton>
                                <TextBlock Style="{StaticResource MutedText}" FontSize="12" Margin="0,14,0,0" TextWrapping="Wrap"
                                           Text="You can switch any time in Settings. Simple mode only hides pages; it doesn't turn anything off."/>
                            </StackPanel>

                            <!-- Step 2: quick check -->
                            <StackPanel Visibility="{Binding IsStep1, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Quick check-up" Style="{StaticResource H1}"/>
                                <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,8,0,16" FontSize="13.5"
                                           Text="Vanta looked at your hardware and Windows settings. Here's what stood out."/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Dashboard.HealthScore}" FontSize="44" FontWeight="Bold" Foreground="{DynamicResource AccentGradientBrush}"/>
                                    <StackPanel VerticalAlignment="Center" Margin="12,0,0,0">
                                        <TextBlock Text="{Binding Dashboard.HealthLabel}" FontSize="16" FontWeight="SemiBold"/>
                                        <TextBlock Text="health score out of 100" Style="{StaticResource MutedText}"/>
                                    </StackPanel>
                                </StackPanel>
                                <ItemsControl ItemsSource="{Binding Problems}" Margin="0,14,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource Card}" Padding="14,10" Margin="0,0,0,8">
                                                <DockPanel>
                                                    <Ellipse DockPanel.Dock="Left" Width="8" Height="8" Margin="0,6,12,0" VerticalAlignment="Top"
                                                             Fill="{Binding Severity, Converter={StaticResource SeverityToBrush}}"/>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Message}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                        <TextBlock Text="{Binding Fix}" Style="{StaticResource MutedText}" TextWrapping="Wrap" FontSize="12" Margin="0,2,0,0"
                                                                   Visibility="{Binding Fix, Converter={StaticResource StringToVis}}"/>
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="Nothing important to fix. Nice." Margin="0,6,0,0" Foreground="{StaticResource GoodBrush}"
                                           Visibility="{Binding NoProblems, Converter={StaticResource BoolToVis}}"/>
                                <DockPanel Margin="0,12,0,0">
                                    <Button DockPanel.Dock="Left" Content="Apply safe fixes" Style="{StaticResource AccentButton}" Command="{Binding ApplySafeFixesCommand}"
                                            IsEnabled="{Binding Dashboard.IsNotBusy}"/>
                                    <TextBlock Style="{StaticResource MutedText}" FontSize="12" TextWrapping="Wrap" Margin="14,0,0,0" VerticalAlignment="Center"
                                               Text="Only low-risk changes with a proven effect. You'll see the list first, and you can undo them all from Change Log."/>
                                </DockPanel>
                                <TextBlock Text="{Binding Dashboard.StatusMessage}" Style="{StaticResource MutedText}" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0"/>
                            </StackPanel>

                            <!-- Step 3: background -->
                            <StackPanel Visibility="{Binding IsStep2, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Set and forget" Style="{StaticResource H1}"/>
                                <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,8,0,18" FontSize="13.5"
                                           Text="Choose what Vanta does on its own. All of it can be changed later."/>
                                <CheckBox Style="{StaticResource SwitchStyle}" IsChecked="{Binding AutoBoost}"
                                          Content="Boost games automatically when they start (and undo it when they close)"/>
                                <CheckBox Style="{StaticResource SwitchStyle}" IsChecked="{Binding SessionReports}" Margin="0,12,0,0"
                                          Content="Write a short report after every game session (FPS, ping, temperatures)"/>
                                <CheckBox Style="{StaticResource SwitchStyle}" IsChecked="{Binding StartWithWindows}" Margin="0,12,0,0"
                                          Content="Start Vanta with Windows, quietly in the tray"/>
                                <CheckBox Style="{StaticResource SwitchStyle}" IsChecked="{Binding CheckForUpdates}" Margin="0,12,0,0"
                                          Content="Tell me when a new version is out (asks GitHub once a day, sends nothing about you)"/>
                                <Border Style="{StaticResource WarnNote}" Margin="0,18,0,0" Visibility="{Binding IsAdmin, Converter={StaticResource InvBoolToVis}}">
                                    <TextBlock TextWrapping="Wrap" Text="Vanta isn't running as administrator right now, so boosting, FPS capture, RAM cleaning and in-game ping are limited. Right-click Vanta.exe and choose 'Run as administrator' for everything to work."/>
                                </Border>
                                <Border Style="{StaticResource Note}" Margin="0,18,0,0">
                                    <TextBlock TextWrapping="Wrap" Text="{Binding HotkeyTip}"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
