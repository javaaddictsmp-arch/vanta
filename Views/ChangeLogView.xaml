<UserControl x:Class="TuneUp.Views.ChangeLogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:TuneUp.Controls"
             Style="{StaticResource ViewFade}">
    <Grid Margin="32,26,32,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <c:Explainer Grid.Row="1" Margin="0,16,0,0"
                     Text="A history of every change Vanta made to your PC. 'Undo' puts back exactly what was there before. 'Revert all changes' takes your PC back to how it was before you ever used Vanta."/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Change Log" Style="{StaticResource H1}"/>
                <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,0" MaxWidth="640"
                           Text="Everything Vanta has changed on this PC. Each change keeps your original value, so Undo puts things back exactly as they were. Registry backups (.reg files) are saved too."/>
                <TextBlock Text="{Binding StatusMessage}" Margin="0,8,0,0" Foreground="{DynamicResource AccentBrush}"
                           Visibility="{Binding StatusMessage, Converter={StaticResource StringToVis}}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <Button Content="Open backups folder" Command="{Binding OpenBackupsCommand}" Margin="0,0,10,0"/>
                <Button Content="Revert all changes" Style="{StaticResource DangerButton}"
                        Command="{Binding RevertAllCommand}" IsEnabled="{Binding HasActiveChanges}"/>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,16,0,0">
            <StackPanel>
                <TextBlock Text="Nothing has been changed yet. Anything you apply will show up here."
                           Style="{StaticResource MutedText}" Margin="0,8,0,0"
                           Visibility="{Binding HasEntries, Converter={StaticResource InvBoolToVis}}"/>

                <ItemsControl ItemsSource="{Binding Rows}" Margin="0,0,0,24">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource HoverCard}" Margin="0,0,0,8" Padding="16,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Time}" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Action}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding TweakName}" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource MutedText}" FontSize="12"
                                                   Visibility="{Binding Detail, Converter={StaticResource StringToVis}}"/>
                                    </StackPanel>
                                    <Button Grid.Column="3" Content="Undo" Margin="12,0,0,0" MinWidth="70"
                                            Visibility="{Binding CanUndo, Converter={StaticResource BoolToVis}}"
                                            Command="{Binding DataContext.UndoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
