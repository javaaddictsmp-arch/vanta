<UserControl x:Class="TuneUp.Views.Boost.TimerTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:TuneUp.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,4,24">
            <c:Explainer Text="A very technical setting about how precisely Windows keeps time. Lots of 'FPS boost' videos push it, but on modern Windows it rarely changes anything. The test below shows whether it does on your PC. Safe to ignore if you are not curious."/>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Timer resolution" Style="{StaticResource H2}"/>
                    <TextBlock Text="{Binding Current}" Margin="0,8,0,0" FontFamily="Consolas"/>
                    <Border Style="{StaticResource WarnNote}" Margin="0,10,0,0">
                        <TextBlock Text="{Binding Behavior}" TextWrapping="Wrap"/>
                    </Border>
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,10,0,0"
                               Text="What it is: how often Windows wakes up to run timers. A finer timer makes Sleep() and some frame limiters more precise. It does not raise FPS by itself, and many games already request 1 ms. Set it per game in Game Booster > profile > Timer resolution; it is always released when the game closes or Vanta exits."/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Run timer benchmark" Style="{StaticResource AccentButton}"
                                Command="{Binding RunBenchmarkCommand}" VerticalAlignment="Top"
                                Visibility="{Binding IsBusy, Converter={StaticResource InvBoolToVis}}"/>
                        <StackPanel>
                            <TextBlock Text="Does it help on my PC?" Style="{StaticResource H2}"/>
                            <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,0"
                                       Text="Measures how long Sleep(1) really takes at your current timer and at 0.5 ms, 300 times each."/>
                        </StackPanel>
                    </DockPanel>
                    <TextBlock Text="{Binding BenchmarkResult}" TextWrapping="Wrap" Margin="0,10,0,0" FontFamily="Consolas" FontSize="12.5"
                               Visibility="{Binding BenchmarkResult, Converter={StaticResource StringToVis}}"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Check now" Command="{Binding FindRequestersCommand}" VerticalAlignment="Top"
                                Visibility="{Binding IsBusy, Converter={StaticResource InvBoolToVis}}"/>
                        <StackPanel>
                            <TextBlock Text="Who is requesting a finer timer?" Style="{StaticResource H2}"/>
                            <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,0"
                                       Text="Runs Windows' own 'powercfg /energy' report for 5 seconds and lists programs holding a timer request (Platform Timer Resolution)."/>
                        </StackPanel>
                    </DockPanel>
                    <TextBlock Text="{Binding RequestersText}" Margin="0,10,0,6" TextWrapping="Wrap"
                               Visibility="{Binding RequestersText, Converter={StaticResource StringToVis}}"/>
                    <ItemsControl ItemsSource="{Binding Requesters}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Margin="0,2">
                                    <Run Text="{Binding Process, Mode=OneWay}" FontWeight="SemiBold"/>
                                    <Run Text="{Binding PeriodMs, Mode=OneWay, StringFormat='  {0:0.###} ms'}" Foreground="{StaticResource MutedBrush}"/>
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="Windows 11 global timer setting" Style="{StaticResource H2}" Margin="0,0,0,10"/>
                    <ItemsControl DataContext="{Binding Tweaks}" ItemsSource="{Binding Items}" ItemTemplate="{StaticResource TweakCard}"/>
                    <TextBlock Style="{StaticResource MutedText}" FontSize="12"
                               Text="Only shown on Windows 11. On Windows 10 there is no supported way to make timer requests global again."/>
                    <TextBlock DataContext="{Binding Tweaks}" Text="{Binding Notice}" Foreground="{StaticResource WarnBrush}" TextWrapping="Wrap"
                               Visibility="{Binding Notice, Converter={StaticResource StringToVis}}"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="HPET and 'useplatformclock'" Style="{StaticResource H2}"/>
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,6,0,0"
                               Text="Guidance only: Vanta does not change boot settings. Forcing HPET with 'bcdedit /set useplatformclock true' usually makes timing slower and stutter worse on modern PCs. If an old guide made you set it, remove it with 'bcdedit /deletevalue useplatformclock' in an admin terminal. Turning HPET off in BIOS is not recommended either; Windows already picks the best timer."/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
