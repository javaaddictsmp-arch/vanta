<UserControl x:Class="TuneUp.Views.Boost.BenchmarkTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:TuneUp.ViewModels"
             xmlns:c="clr-namespace:TuneUp.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,4,24">
            <c:Explainer Text="This measures how smoothly a game really runs, so you can see whether a change helped. Play the same part of a game twice: once before (A) and once after (B) you change something. Vanta compares them and tells you honestly if the difference is real or just luck."/>
            <Expander Header="What do these words mean?" Margin="2,0,0,14">
                <Border Style="{StaticResource Card}" Margin="17,0,0,0" Padding="14,12">
                    <StackPanel>
                        <TextBlock TextWrapping="Wrap" Margin="0,2"><Run Text="FPS" FontWeight="SemiBold"/><Run Text="  Frames per second: how many pictures the game draws each second. Higher is smoother."/></TextBlock>
                        <TextBlock TextWrapping="Wrap" Margin="0,2"><Run Text="Frametime" FontWeight="SemiBold"/><Run Text="  How long one frame took, in milliseconds. Even frametimes feel smooth; spikes feel like stutter."/></TextBlock>
                        <TextBlock TextWrapping="Wrap" Margin="0,2"><Run Text="1% low / 0.1% low" FontWeight="SemiBold"/><Run Text="  How bad the worst moments are. Often matters more than average FPS: high average with low 1% lows still feels choppy."/></TextBlock>
                        <TextBlock TextWrapping="Wrap" Margin="0,2"><Run Text="Stutter" FontWeight="SemiBold"/><Run Text="  A frame that took much longer than normal: the hitch you feel."/></TextBlock>
                        <TextBlock TextWrapping="Wrap" Margin="0,2"><Run Text="Within noise" FontWeight="SemiBold"/><Run Text="  The difference is smaller than what two identical runs would differ by, so it is not a real improvement."/></TextBlock>
                        <TextBlock TextWrapping="Wrap" Margin="0,2"><Run Text="CPU-bound / GPU-bound" FontWeight="SemiBold"/><Run Text="  Which part is holding FPS back: the processor (CPU) or the graphics card (GPU). Upgrading or tuning the other one won't help much."/></TextBlock>
                        <TextBlock TextWrapping="Wrap" Margin="0,2"><Run Text="VRAM" FontWeight="SemiBold"/><Run Text="  The graphics card's own memory. When it is full, games stutter; lower texture quality fixes it."/></TextBlock>
                    </StackPanel>
                </Border>
            </Expander>

            <!-- Capture -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Toggle overlay" Command="{Binding ToggleOverlayCommand}" VerticalAlignment="Top"/>
                        <StackPanel>
                            <TextBlock Text="A/B frametime benchmark" Style="{StaticResource H2}"/>
                            <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,0" MaxWidth="760" HorizontalAlignment="Left"
                                       Text="Record run A, change ONE thing, record run B in the same scene. Vanta reports average FPS, 1% and 0.1% lows and stutters, and tells you honestly when the difference is just run-to-run noise. Uses the same Windows events as PresentMon/CapFrameX."/>
                        </StackPanel>
                    </DockPanel>

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Find games" Margin="8,0,0,0" Command="{Binding FindGamesCommand}"/>
                            <ComboBox ItemsSource="{Binding Targets}" SelectedItem="{Binding Target}" ToolTip="Program to measure (busiest first)">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock>
                                            <Run Text="{Binding Name, Mode=OneWay}"/>
                                            <Run Text="{Binding Fps, Mode=OneWay, StringFormat='  ~{0:0} FPS'}" Foreground="{StaticResource MutedBrush}"/>
                                        </TextBlock>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </DockPanel>
                        <ComboBox Grid.Column="1" Margin="8,0,0,0" ItemsSource="{x:Static vm:BenchmarkTabViewModel.DurationOptions}"
                                  DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Duration}"/>
                        <TextBox Grid.Column="2" Margin="8,0,0,0" Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}" ToolTip="Label for this run"/>
                        <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="8,0,0,0">
                            <Button Content="Start capture" Style="{StaticResource AccentButton}" Command="{Binding StartCaptureCommand}"
                                    Visibility="{Binding IsCapturing, Converter={StaticResource InvBoolToVis}}"/>
                            <Button Content="Cancel" Style="{StaticResource DangerButton}" Command="{Binding CancelCaptureCommand}"
                                    Visibility="{Binding IsCapturing, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                    </Grid>
                    <ProgressBar Style="{StaticResource Bar}" Value="{Binding Progress}" Margin="0,12,0,0"
                                 Visibility="{Binding IsCapturing, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <!-- Compare -->
            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="Compare runs" Style="{StaticResource H2}" Margin="0,0,0,10"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="A" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding History}" SelectedItem="{Binding CompareA}" DisplayMemberPath="Title"/>
                        <TextBlock Grid.Column="2" Text="B" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        <ComboBox Grid.Column="3" ItemsSource="{Binding History}" SelectedItem="{Binding CompareB}" DisplayMemberPath="Title"/>
                    </Grid>
                    <TextBlock Text="{Binding Comparison}" TextWrapping="Wrap" Margin="0,12,0,0"/>
                </StackPanel>
            </Border>

            <!-- History + graph -->
            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="420"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}" Margin="0,0,12,0" Padding="10">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="History" Style="{StaticResource H2}" Margin="4,0,0,8"/>
                        <ListBox ItemsSource="{Binding History}" SelectedItem="{Binding SelectedResult}" Style="{StaticResource PlainList}" MaxHeight="360">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ResultRowVm}">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="&#xE74D;" FontFamily="Segoe MDL2 Assets" Padding="6,4" FontSize="11"
                                                ToolTip="Delete this run" VerticalAlignment="Top"
                                                Command="{Binding DataContext.DeleteResultCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}"/>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Summary}" Style="{StaticResource MutedText}" FontSize="11.5"/>
                                            <TextBlock Text="{Binding When}" Style="{StaticResource MutedText}" FontSize="11"/>
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource Card}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Frametime graph" Style="{StaticResource H2}"/>
                        <TextBlock DockPanel.Dock="Bottom" Text="{Binding GraphCaption}" Style="{StaticResource MutedText}" FontSize="12" Margin="0,8,0,0"/>
                        <c:Sparkline Values="{Binding Graph}" Stroke="{DynamicResource AccentBrush}" MinHeight="220" Margin="0,10,0,0"/>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- Bottleneck -->
            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Analyze for 20 s" Command="{Binding AnalyzeBottleneckCommand}"
                                Visibility="{Binding IsAnalyzing, Converter={StaticResource InvBoolToVis}}" VerticalAlignment="Top"/>
                        <StackPanel>
                            <TextBlock Text="Bottleneck finder" Style="{StaticResource H2}"/>
                            <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,0"
                                       Text="Runs automatically during every capture, or on demand while you play. It reads CPU per-thread, GPU, VRAM, RAM, disk and temperatures."/>
                        </StackPanel>
                    </DockPanel>
                    <TextBlock Text="{Binding BottleneckVerdict}" FontSize="16" FontWeight="SemiBold" Margin="0,12,0,0"
                               Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap"
                               Visibility="{Binding BottleneckVerdict, Converter={StaticResource StringToVis}}"/>
                    <ItemsControl ItemsSource="{Binding BottleneckEvidence}" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding StringFormat='•  {0}'}" Style="{StaticResource MutedText}" Margin="0,1"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ItemsControl ItemsSource="{Binding BottleneckFixes}" Margin="0,10,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock TextWrapping="Wrap" Margin="0,2">
                                    <Run Text="&#x2192;  " Foreground="{StaticResource GoodBrush}"/>
                                    <Run Text="{Binding Mode=OneWay}"/>
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
