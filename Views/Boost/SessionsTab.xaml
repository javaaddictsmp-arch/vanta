<UserControl x:Class="TuneUp.Views.Boost.SessionsTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:TuneUp.ViewModels"
             xmlns:c="clr-namespace:TuneUp.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,4,24">
            <c:Explainer Text="Every time you play, Vanta quietly writes down how it went: FPS, stutters, ping to the game server, temperatures and what held your PC back. When you close the game you get a short report, so you can see if the last tweak actually made a difference."/>

            <Border Style="{StaticResource Card}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button Content="Open folder" Command="{Binding OpenFolderCommand}" Margin="0,0,12,0"/>
                        <CheckBox Style="{StaticResource SwitchStyle}" IsChecked="{Binding Enabled}" Content="Record sessions" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Session reports" Style="{StaticResource H2}"/>
                        <TextBlock Text="{Binding RecordingStatus}" Style="{StaticResource MutedText}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Border Style="{StaticResource Note}" Margin="0,12,0,0" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                <TextBlock TextWrapping="Wrap" Text="No reports yet. Play any detected game for more than 2 minutes, close it, and the first report shows up here (plus a pop-up from the tray icon)."/>
            </Border>

            <Grid Margin="0,12,0,0" Visibility="{Binding IsEmpty, Converter={StaticResource InvBoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}" Margin="0,0,12,0" Padding="10" VerticalAlignment="Top">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Your sessions" Style="{StaticResource H2}" Margin="4,0,0,8"/>
                        <ListBox ItemsSource="{Binding History}" SelectedItem="{Binding Selected}" Style="{StaticResource PlainList}" MaxHeight="620">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:SessionRowVm}">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="&#xE74D;" FontFamily="Segoe MDL2 Assets" Padding="6,4" FontSize="11"
                                                ToolTip="Delete this report" VerticalAlignment="Top"
                                                Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}"/>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="4" Padding="5,0" Margin="6,0,0,0" VerticalAlignment="Center"
                                                        Visibility="{Binding Boosted, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="BOOSTED" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Summary}" Style="{StaticResource MutedText}" FontSize="11.5"/>
                                            <TextBlock Text="{Binding When}" Style="{StaticResource MutedText}" FontSize="11"/>
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <StackPanel Grid.Column="1">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="{Binding Headline}" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap"/>
                            <ItemsControl ItemsSource="{Binding Tiles}" Margin="0,12,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:StatTile}">
                                        <Border Width="150" Margin="0,0,10,10" Padding="12,10" CornerRadius="10"
                                                Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardEdgeBrush}" BorderThickness="1">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Label}" Style="{StaticResource MutedText}" FontSize="11.5"/>
                                                <TextBlock Text="{Binding Value}" FontSize="20" FontWeight="Bold" Margin="0,2,0,0" Foreground="{DynamicResource AccentBrush}"/>
                                                <TextBlock Text="{Binding Sub}" Style="{StaticResource MutedText}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{Binding FpsNote}" Style="{StaticResource MutedText}" FontSize="12" TextWrapping="Wrap"
                                       Visibility="{Binding FpsNote, Converter={StaticResource StringToVis}}"/>
                            <Border Style="{StaticResource Note}" Margin="0,6,0,0" Visibility="{Binding Comparison, Converter={StaticResource StringToVis}}">
                                <TextBlock Text="{Binding Comparison}" TextWrapping="Wrap"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,12,0,0" Visibility="{Binding HasFps, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="FPS over the session" Style="{StaticResource H2}"/>
                            <TextBlock Text="Each point is a 10-second average. Dips usually line up with busy fights or loading new areas." Style="{StaticResource MutedText}" FontSize="12" Margin="0,2,0,0"/>
                            <c:Sparkline Values="{Binding FpsGraph}" Stroke="{DynamicResource AccentBrush}" Height="130" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,12,0,0" Visibility="{Binding HasPing, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="Ping over the session" Style="{StaticResource H2}"/>
                            <TextBlock Text="Ping to the game server, 10-second averages. Spikes that line up with lag are worth checking in Network &amp; Ping." Style="{StaticResource MutedText}" FontSize="12" Margin="0,2,0,0"/>
                            <c:Sparkline Values="{Binding PingGraph}" Stroke="{StaticResource GoodBrush}" Height="100" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,12,0,0" Visibility="{Binding Bottleneck, Converter={StaticResource StringToVis}}">
                        <StackPanel>
                            <TextBlock Text="What held your PC back" Style="{StaticResource H2}"/>
                            <TextBlock Text="{Binding Bottleneck}" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap"/>
                            <ItemsControl ItemsSource="{Binding Evidence}" Margin="0,8,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StringFormat='•  {0}'}" Style="{StaticResource MutedText}" Margin="0,1"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ItemsControl ItemsSource="{Binding Tips}" Margin="0,10,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock TextWrapping="Wrap" Margin="0,2">
                                            <Run Text="&#x2192;  " Foreground="{StaticResource GoodBrush}"/>
                                            <Run Text="{Binding Mode=OneWay}"/>
                                        </TextBlock>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Expander Header="What the boost did this session" Margin="2,12,0,0"
                              Visibility="{Binding Selected.Boosted, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
                        <Border Style="{StaticResource Card}" Margin="17,0,0,0" Padding="14,12">
                            <ItemsControl ItemsSource="{Binding BoostSteps}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StringFormat='✓  {0}'}" Margin="0,1" TextWrapping="Wrap"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </Expander>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
