<UserControl x:Class="TuneUp.Views.Boost.BoostCenterView"
             xmlns:vm="clr-namespace:TuneUp.ViewModels"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Style="{StaticResource ViewFade}">
    <Grid Margin="32,26,32,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="FPS Boost Center" Style="{StaticResource H1}"/>
            <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,0" MaxWidth="820" HorizontalAlignment="Left"
                       Text="Automatic game boosting that undoes itself when you quit, plus the tools to prove what actually helps on your PC. Nothing is ever injected into games."/>
        </StackPanel>

        <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTab}">
            <TabItem Header="Game Booster"><ContentControl Content="{Binding Booster}"/></TabItem>
            <TabItem Header="Session reports"><ContentControl Content="{Binding Sessions}"/></TabItem>
            <TabItem Header="Benchmark &amp; Bottleneck"><ContentControl Content="{Binding Benchmark}"/></TabItem>
            <TabItem Header="CPU &amp; Power" Visibility="{Binding IsAdvanced, Source={x:Static vm:UiMode.Instance}, Converter={StaticResource BoolToVis}}"><ContentControl Content="{Binding CpuPower}"/></TabItem>
            <TabItem Header="Timer" Visibility="{Binding IsAdvanced, Source={x:Static vm:UiMode.Instance}, Converter={StaticResource BoolToVis}}"><ContentControl Content="{Binding Timer}"/></TabItem>
            <TabItem Header="GPU &amp; Display"><ContentControl Content="{Binding Gpu}"/></TabItem>
            <TabItem Header="Game Configs"><ContentControl Content="{Binding Configs}"/></TabItem>
            <TabItem Header="Latency" Visibility="{Binding IsAdvanced, Source={x:Static vm:UiMode.Instance}, Converter={StaticResource BoolToVis}}"><ContentControl Content="{Binding Latency}"/></TabItem>
        </TabControl>
    </Grid>
</UserControl>
