<UserControl x:Class="TuneUp.Views.Boost.LatencyTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:TuneUp.ViewModels"
             xmlns:c="clr-namespace:TuneUp.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,4,24">
            <c:Explainer Text="Latency is the delay between pressing a button and seeing it happen on screen. The check below finds drivers that cause tiny freezes or crackling sound. Everything further down is for enthusiasts: if you are not sure, skip it."/>

            <!-- DPC / ISR -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="System latency check (DPC / ISR)" Style="{StaticResource H2}"/>
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,10" MaxWidth="780" HorizontalAlignment="Left"
                               Text="Measures how long drivers block the CPU, like LatencyMon. Run once labelled 'Before', apply a tweak (or update a driver), reboot if needed, then run 'After'. Long DPCs cause audio crackle and input hitches."/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox ItemsSource="{x:Static vm:LatencyTabViewModel.DurationOptions}" DisplayMemberPath="Label"
                                  SelectedValuePath="Value" SelectedValue="{Binding Duration}"/>
                        <TextBox Grid.Column="1" Margin="8,0,0,0" Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}"/>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,0">
                            <Button Content="Start check" Style="{StaticResource AccentButton}" Command="{Binding SampleCommand}"
                                    Visibility="{Binding IsBusy, Converter={StaticResource InvBoolToVis}}"/>
                            <Button Content="Cancel" Style="{StaticResource DangerButton}" Command="{Binding CancelCommand}"
                                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,10,0,0"
                               Visibility="{Binding Status, Converter={StaticResource StringToVis}}"/>

                    <ItemsControl ItemsSource="{Binding Reports}" Margin="0,10,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource Surface2Brush}" CornerRadius="8" Padding="12,8" Margin="0,0,0,6">
                                    <StackPanel>
                                        <TextBlock FontWeight="SemiBold">
                                            <Run Text="{Binding Label, Mode=OneWay}"/>
                                            <Run Text="{Binding DurationSec, Mode=OneWay, StringFormat='  ({0:0} s)'}" Foreground="{StaticResource MutedBrush}"/>
                                        </TextBlock>
                                        <TextBlock FontFamily="Consolas" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap">
                                            <Run Text="{Binding MaxDpcUs, Mode=OneWay, StringFormat='DPC max {0:0} µs'}"/>
                                            <Run Text="{Binding P99DpcUs, Mode=OneWay, StringFormat='  p99 {0:0} µs'}"/>
                                            <Run Text="{Binding WorstDpcDriver, Mode=OneWay, StringFormat='  worst: {0}'}"/>
                                            <LineBreak/>
                                            <Run Text="{Binding MaxIsrUs, Mode=OneWay, StringFormat='ISR max {0:0} µs'}"/>
                                            <Run Text="{Binding P99IsrUs, Mode=OneWay, StringFormat='  p99 {0:0} µs'}"/>
                                            <Run Text="{Binding WorstIsrDriver, Mode=OneWay, StringFormat='  worst: {0}'}"/>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Verdict}" Style="{StaticResource MutedText}" FontSize="12" Margin="0,4,0,0"/>
                                        <TextBlock Text="{Binding Error}" Foreground="{StaticResource BadBrush}" TextWrapping="Wrap"
                                                   Visibility="{Binding Error, Converter={StaticResource StringToVis}}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Input -->
            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="Input latency" Style="{StaticResource H2}" Margin="0,0,0,10"/>
                    <ItemsControl DataContext="{Binding Tweaks}" ItemsSource="{Binding Items}" ItemTemplate="{StaticResource TweakCard}"/>
                    <TextBlock DataContext="{Binding Tweaks}" Text="{Binding Notice}" Foreground="{StaticResource WarnBrush}" TextWrapping="Wrap"
                               Visibility="{Binding Notice, Converter={StaticResource StringToVis}}"/>
                    <TextBlock TextWrapping="Wrap" Margin="0,6,0,0"
                               Text="•  Mouse polling rate: 1000 Hz is the sweet spot. 4000-8000 Hz lowers latency a fraction of a millisecond but costs CPU time and causes stutter in some games; set it in the mouse's own software."/>
                    <TextBlock TextWrapping="Wrap" Margin="0,4,0,0"
                               Text="•  USB selective suspend: switched off in the Vanta Performance plan while boosting (CPU &amp; Power tab)."/>
                    <TextBlock TextWrapping="Wrap" Margin="0,4,0,0"
                               Text="•  Network adapter tweaks (interrupt moderation, Green Ethernet, power saving, RSS) live in Network &amp; Ping (Phase 4)."/>
                </StackPanel>
            </Border>

            <!-- MSI mode -->
            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="List devices" Command="{Binding LoadDevicesCommand}" VerticalAlignment="Top"/>
                        <StackPanel>
                            <TextBlock Text="MSI mode (message-signaled interrupts)" Style="{StaticResource H2}"/>
                            <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,0" MaxWidth="760" HorizontalAlignment="Left"
                                       Text="Advanced. Shows GPU, network, USB, storage and audio controllers. Most modern devices already use MSI. Change one device at a time, reboot, and check it still works. Every change is backed up and undoable from the Change Log."/>
                        </StackPanel>
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding Devices}" Margin="0,10,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:MsiRowVm}">
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="190"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Device.InstanceId}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Class}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Status}" VerticalAlignment="Center"/>
                                    <Button Grid.Column="3" MinWidth="110" Content="{Binding Tweak.ActionText}" IsEnabled="{Binding Tweak.IsNotBusy}"
                                            Command="{Binding DataContext.ToggleMsiCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding MsiNotice}" Foreground="{StaticResource WarnBrush}" TextWrapping="Wrap"
                               Visibility="{Binding MsiNotice, Converter={StaticResource StringToVis}}"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="Interrupt affinity" Style="{StaticResource H2}"/>
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,6,0,0"
                               Text="Guidance only. Pinning a device's interrupts to a specific core (Microsoft's Interrupt Affinity Policy Tool) can help in very specific cases, for example moving GPU or NIC interrupts off the core a game's main thread uses. Measure with the DPC check above before and after; on most PCs Windows' default spreading is as good or better. Vanta does not change it automatically because a wrong mask can make a device unstable."/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
