<UserControl x:Class="TuneUp.Views.TweaksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:TuneUp.Controls"
             Style="{StaticResource ViewFade}">
    <Grid Margin="32,26,32,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Tweaks" Style="{StaticResource H1}"/>
                <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,0" MaxWidth="640" HorizontalAlignment="Left"
                           Text="Windows settings that can make games feel smoother, each with an honest rating."/>
            </StackPanel>
            <Grid Grid.Column="1" VerticalAlignment="Top">
                <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Padding="34,8,9,8" ToolTip="Search tweaks"/>
                <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource MutedBrush}"
                           VerticalAlignment="Center" Margin="12,0,0,0" IsHitTestVisible="False"/>
            </Grid>
        </Grid>

        <StackPanel Grid.Row="1">
            <c:Explainer Text="Each card is one Windows setting Vanta can change for you. Read the coloured tag first: it tells you whether it is worth it. Nothing changes until you click Apply, and Revert puts it back exactly as it was."/>
            <Expander Header="What do the tags mean?" Margin="2,0,0,12">
                <Border Style="{StaticResource Card}" Margin="17,0,0,0" Padding="14,12">
                    <StackPanel>
                        <TextBlock TextWrapping="Wrap" Margin="0,2"><Run Text="●  Recommended" Foreground="{StaticResource GoodBrush}" FontWeight="SemiBold"/><Run Text="  Safe and proven to help on most PCs. Go for it."/></TextBlock>
                        <TextBlock TextWrapping="Wrap" Margin="0,2"><Run Text="●  Worth a try" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"/><Run Text="  Safe, helps on some PCs. Little to lose."/></TextBlock>
                        <TextBlock TextWrapping="Wrap" Margin="0,2"><Run Text="●  Only if it fits your PC" Foreground="{StaticResource WarnBrush}" FontWeight="SemiBold"/><Run Text="  Helps in specific situations; read the details first."/></TextBlock>
                        <TextBlock TextWrapping="Wrap" Margin="0,2"><Run Text="●  Skip unless curious" Foreground="{StaticResource MutedBrush}" FontWeight="SemiBold"/><Run Text="  Popular online, but tests show little or no difference."/></TextBlock>
                        <TextBlock TextWrapping="Wrap" Margin="0,2"><Run Text="●  Experts only" Foreground="{StaticResource BadBrush}" FontWeight="SemiBold"/><Run Text="  Real trade-offs (for example lower security). Only if you know why you want it."/></TextBlock>
                        <TextBlock Style="{StaticResource MutedText}" FontSize="12" Margin="0,8,0,0"
                                   Text="Risk = how much can go wrong. Evidence = how sure we are it helps (Proven, Situational, Placebo/Marginal). Every change makes a backup first and shows up in the Change Log."/>
                    </StackPanel>
                </Border>
            </Expander>
        </StackPanel>

        <!-- Restart / sign-out / restore point notice -->
        <Border Grid.Row="2" Style="{StaticResource WarnNote}" Margin="0,0,0,10"
                Visibility="{Binding Notice, Converter={StaticResource StringToVis}}">
            <TextBlock Text="{Binding Notice}" TextWrapping="Wrap"/>
        </Border>

        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding View}" ItemTemplate="{StaticResource TweakCard}" Margin="0,0,6,24">
                <ItemsControl.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="2,12,0,10">
                                    <Border Width="4" Height="16" CornerRadius="2" Background="{DynamicResource AccentGradientBrush}" Margin="0,0,10,0"/>
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource H2}"/>
                                </StackPanel>
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ItemsControl.GroupStyle>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
