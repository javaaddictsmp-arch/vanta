<UserControl x:Class="TuneUp.Views.MonitoringView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:TuneUp.Controls"
             Style="{StaticResource ViewFade}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,26,32,32">

            <TextBlock Text="Monitoring" Style="{StaticResource H1}"/>
            <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,16"
                       Text="Live readings, updated every second. History shows the last two minutes."/>
            <c:Explainer Text="A live look inside your PC. If a graph turns orange or red, that part is running hot or getting full. Tip: keep this open on a second screen while you play to see what is really going on."/>

            <!-- Alerts -->
            <Border Style="{StaticResource Card}" Margin="0,14,0,0" Padding="12,8" Background="#22FF5C6C"
                    BorderBrush="{StaticResource BadBrush}"
                    Visibility="{Binding AlertText, Converter={StaticResource StringToVis}}">
                <TextBlock Text="{Binding AlertText}" TextWrapping="Wrap" Foreground="{StaticResource BadBrush}"/>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,14,0,0" Padding="12,8"
                    Visibility="{Binding SensorNote, Converter={StaticResource StringToVis}}">
                <TextBlock Text="{Binding SensorNote}" TextWrapping="Wrap" Foreground="{StaticResource WarnBrush}"/>
            </Border>

            <!-- Sparkline cards -->
            <ItemsControl ItemsSource="{Binding Cards}" Margin="0,14,0,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="4"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,10,10" Padding="12,10">
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" Style="{StaticResource MutedText}" FontSize="12"/>
                                <TextBlock Text="{Binding ValueText}" FontSize="18" FontWeight="SemiBold" Margin="0,2,0,6"
                                           TextTrimming="CharacterEllipsis"/>
                                <c:Sparkline Height="64" Max="{Binding Max}" Values="{Binding Values}"
                                             Stroke="{Binding Level, Converter={StaticResource LevelToBrush}}"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Grid Margin="0,2,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="340"/>
                </Grid.ColumnDefinitions>

                <!-- Per-thread load -->
                <Border Style="{StaticResource Card}" Margin="0,0,10,0" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="CPU load per thread" Style="{StaticResource H2}" Margin="0,0,0,10"/>
                        <ItemsControl ItemsSource="{Binding Cores}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="3"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,16,10">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Load, StringFormat={}{0:0}%}"
                                                       Style="{StaticResource MutedText}" FontSize="12"/>
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource MutedText}" FontSize="12"/>
                                        </DockPanel>
                                        <ProgressBar Style="{StaticResource Bar}" Value="{Binding Load, Mode=OneWay}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Logging + alerts -->
                <Border Grid.Column="1" Style="{StaticResource Card}" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="CSV logging" Style="{StaticResource H2}"/>
                        <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,10"
                                   Text="Saves every reading to a file on this PC so you can chart it later. Nothing is uploaded."/>
                        <CheckBox Style="{StaticResource SwitchStyle}" Content="Log readings to CSV"
                                  IsChecked="{Binding IsLogging}"/>
                        <TextBlock Text="{Binding LogFile}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,8,0,0"
                                   Visibility="{Binding LogFile, Converter={StaticResource StringToVis}}"/>
                        <Button Content="Open log folder" Command="{Binding OpenLogFolderCommand}"
                                HorizontalAlignment="Left" Margin="0,10,0,0"/>

                        <TextBlock Text="Temperature alerts" Style="{StaticResource H2}" Margin="0,22,0,6"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="70"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="CPU alert at (°C)" VerticalAlignment="Center" Margin="0,0,0,8"/>
                            <TextBox Grid.Column="1" Text="{Binding CpuTempLimit, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,8"/>
                            <TextBlock Grid.Row="1" Text="GPU alert at (°C)" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding GpuTempLimit, UpdateSourceTrigger=LostFocus}"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>
