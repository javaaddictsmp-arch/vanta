<UserControl x:Class="TuneUp.Views.PlaceholderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Style="{StaticResource ViewFade}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,24,28,28" MaxWidth="760" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Title}" Style="{StaticResource H1}"/>
                <Border Style="{StaticResource Chip}" Background="{StaticResource Surface2Brush}"
                        Margin="14,0,0,0" VerticalAlignment="Center" Padding="10,3">
                    <TextBlock Text="{Binding Phase}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"/>
                </Border>
            </StackPanel>

            <TextBlock Text="{Binding Description}" Style="{StaticResource MutedText}" Margin="0,6,0,0"/>

            <Border Style="{StaticResource Card}" Margin="0,18,0,0">
                <StackPanel>
                    <TextBlock Text="Planned for this section" Style="{StaticResource H2}" Margin="0,0,0,10"/>
                    <ItemsControl ItemsSource="{Binding Planned}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,0,0,8">
                                    <TextBlock DockPanel.Dock="Left" Text="•" Width="16" Foreground="{DynamicResource AccentBrush}"/>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource MutedText}" Margin="0,14,0,0"
                       Text="Built in phases so each part is tested before the next is added. This page unlocks when its phase is delivered."/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
