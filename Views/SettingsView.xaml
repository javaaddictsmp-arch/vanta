<UserControl x:Class="TuneUp.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:TuneUp.Controls"
             Style="{StaticResource ViewFade}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,26,32,32" MaxWidth="780" HorizontalAlignment="Left">

            <TextBlock Text="Settings" Style="{StaticResource H1}" Margin="0,0,0,16"/>
            <c:Explainer Text="Make Vanta yours and choose how careful it should be. Vanta has no account, no ads and no tracking."/>

            <Border Style="{StaticResource Card}" Margin="0,4,0,12">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Run setup again" Command="{Binding OpenSetupCommand}" VerticalAlignment="Top"/>
                        <TextBlock Text="How much to show" Style="{StaticResource H2}"/>
                    </DockPanel>
                    <CheckBox Style="{StaticResource SwitchStyle}" Margin="0,12,0,0" IsChecked="{Binding Mode.IsSimple}"
                              Content="Simple mode: only the everyday pages"/>
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,8,0,0" TextWrapping="Wrap"
                               Text="Hides Tweaks, Monitoring, Privacy &amp; Tools and the expert tabs (Timer, Latency, CPU &amp; Power, Services, Processes, adapter settings, QoS). Nothing is switched off, only hidden; tweaks you applied stay applied."/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Accent colour" Style="{StaticResource H2}"/>
                    <ItemsControl ItemsSource="{Binding Accents}" Margin="0,10,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Width="36" Height="36" Padding="0" Margin="0,0,10,0" ToolTip="{Binding}"
                                        Background="{Binding Converter={StaticResource HexToBrush}}"
                                        BorderBrush="#33FFFFFF"
                                        Command="{Binding DataContext.SetAccentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="Safety" Style="{StaticResource H2}"/>
                    <CheckBox Style="{StaticResource SwitchStyle}" Margin="0,12,0,0"
                              Content="Create a Windows restore point before the first change each session"
                              IsChecked="{Binding CreateRestorePoint}"/>
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,8,0,0"
                               Text="Needs System Protection turned on for your system drive. Windows only allows one automatic restore point per 24 hours. Registry backups and the change log are always kept regardless of this setting."/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="Your data" Style="{StaticResource H2}"/>
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,6,0,0"
                               Text="Everything stays on this PC: logs, backups, the change log and settings. Vanta has no telemetry and no ads. It only goes online for tests you click (ping, speed test, DNS benchmark, app updates), the in-game ping while you play, links you open, and the update check below if you leave it on."/>
                    <TextBlock Text="{Binding DataFolder}" Margin="0,8,0,0" FontFamily="Consolas" FontSize="12"/>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="Open data folder" Command="{Binding OpenDataFolderCommand}" Margin="0,0,10,0"/>
                        <Button Content="Open custom tweak folder" Command="{Binding OpenCatalogFolderCommand}"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,8,0,0" FontSize="12"
                               Text="Drop extra tweak .json files into the custom tweak folder (same format as the built-in catalog) and restart Vanta to load them."/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="Background and startup" Style="{StaticResource H2}"/>
                    <CheckBox Style="{StaticResource SwitchStyle}" Margin="0,12,0,0" IsChecked="{Binding StartWithWindows}"
                              Content="Start Vanta with Windows (in the tray, so auto-boost is always ready)"/>
                    <CheckBox Style="{StaticResource SwitchStyle}" Margin="0,10,0,0" IsChecked="{Binding MinimizeToTray}"
                              Content="Minimizing hides Vanta to the tray (the X button still closes it)"/>
                    <CheckBox Style="{StaticResource SwitchStyle}" Margin="0,10,0,0" IsChecked="{Binding HotkeyEnabled}"
                              Content="Boost hotkey: boosts the running game, press again to stop"/>
                    <Grid Margin="54,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="HotkeyBox" Text="{Binding HotkeyText, Mode=OneWay}" IsReadOnly="True" FontWeight="SemiBold"
                                 PreviewKeyDown="OnHotkeyKeyDown" ToolTip="Click here, then press the combination you want (for example Ctrl+Alt+F10)" Cursor="Hand"/>
                        <TextBlock Grid.Column="1" Text="Click the box and press a new combination" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    </Grid>
                    <TextBlock Text="{Binding HotkeyStatus}" Margin="54,6,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource AccentBrush}"
                               Visibility="{Binding HotkeyStatus, Converter={StaticResource StringToVis}}"/>
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,8,0,0" FontSize="12"
                               Text="The tray icon (bottom right) has quick actions: auto-boost on/off, boost now, and switching power plans."/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="Backup and reset" Style="{StaticResource H2}"/>
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,6,0,10"
                               Text="Export your settings and game profiles to move them to another PC. 'Reset everything' puts Windows back the way it was before Vanta: every tweak, the power plan, DNS, adapter settings, QoS policies and scheduled tasks."/>
                    <WrapPanel>
                        <Button Content="Export settings" Command="{Binding ExportSettingsCommand}" Margin="0,0,8,6"/>
                        <Button Content="Import settings" Command="{Binding ImportSettingsCommand}" Margin="0,0,8,6"/>
                        <Button Content="Reset everything to Windows defaults" Style="{StaticResource DangerButton}" Command="{Binding ResetEverythingCommand}"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InvBool}}" Margin="0,0,0,6"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Note}" Margin="0,12,0,0" Visibility="{Binding Status, Converter={StaticResource StringToVis}}">
                <TextBlock Text="{Binding Status}" TextWrapping="Wrap"/>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Check now" Command="{Binding CheckNowCommand}" VerticalAlignment="Top"/>
                        <StackPanel>
                            <TextBlock Text="Updates" Style="{StaticResource H2}"/>
                            <TextBlock Text="{Binding Version}" Style="{StaticResource MutedText}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </DockPanel>
                    <CheckBox Style="{StaticResource SwitchStyle}" Margin="0,12,0,0" IsChecked="{Binding CheckForUpdates}"
                              Content="Tell me when a new version is out"/>
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,8,0,0" FontSize="12" TextWrapping="Wrap"
                               Text="Asks GitHub once when Vanta starts and then once a day. Nothing about you or your PC is sent, and Vanta never downloads or installs anything by itself: it just shows a link in the sidebar."/>
                    <TextBlock Text="{Binding UpdateStatus}" Margin="0,8,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource AccentBrush}"
                               Visibility="{Binding UpdateStatus, Converter={StaticResource StringToVis}}"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
