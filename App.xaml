<Application x:Class="TuneUp.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:TuneUp.ViewModels"
             xmlns:views="clr-namespace:TuneUp.Views"
             xmlns:boost="clr-namespace:TuneUp.Views.Boost"
             xmlns:conv="clr-namespace:TuneUp.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Converters -->
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
            <conv:InverseBoolToVisibilityConverter x:Key="InvBoolToVis"/>
            <conv:StringToVisibilityConverter x:Key="StringToVis"/>
            <conv:NotNullToVisibilityConverter x:Key="NotNullToVis"/>
            <conv:LevelToBrushConverter x:Key="LevelToBrush"/>
            <conv:RiskToBrushConverter x:Key="RiskToBrush"/>
            <conv:EvidenceToBrushConverter x:Key="EvidenceToBrush"/>
            <conv:SeverityToBrushConverter x:Key="SeverityToBrush"/>
            <conv:VerdictToBrushConverter x:Key="VerdictToBrush"/>
            <conv:ImpactToBrushConverter x:Key="ImpactToBrush"/>
            <conv:InverseBoolConverter x:Key="InvBool"/>
            <conv:SizeToTextConverter x:Key="SizeText"/>
            <conv:HexToBrushConverter x:Key="HexToBrush"/>

            <!-- Compact tweak card used inside FPS Boost Center tabs. The ItemsControl's
                 DataContext must be a TweakListVm (it provides ToggleCommand). -->
            <DataTemplate x:Key="TweakCard" DataType="{x:Type vm:TweakItemVm}">
                <Border Style="{StaticResource HoverCard}" Background="{StaticResource Surface2Brush}" Padding="16,14" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <!-- Title + beginner verdict -->
                            <WrapPanel>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14.5" TextWrapping="Wrap"
                                           Margin="0,0,10,4" VerticalAlignment="Center"/>
                                <Border Style="{StaticResource Chip}" Background="#14FFFFFF" VerticalAlignment="Center" Margin="0,0,6,4">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="7" Height="7" Margin="0,0,6,0" VerticalAlignment="Center"
                                                 Fill="{Binding VerdictLevel, Converter={StaticResource VerdictToBrush}}"/>
                                        <TextBlock Text="{Binding Verdict}" FontSize="11.5" FontWeight="SemiBold"
                                                   Foreground="{Binding VerdictLevel, Converter={StaticResource VerdictToBrush}}"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Chip}" Background="#1F34E3A0" VerticalAlignment="Center" Margin="0,0,6,4"
                                        Visibility="{Binding IsApplied, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="&#x2713; Active" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource GoodBrush}"/>
                                </Border>
                            </WrapPanel>

                            <!-- Plain English first -->
                            <TextBlock Text="{Binding Simple}" TextWrapping="Wrap" Margin="0,4,0,0" FontSize="13.5"/>

                            <!-- Honest ratings, always visible -->
                            <WrapPanel Margin="0,10,0,0">
                                <Border Style="{StaticResource Chip}" Background="#12FFFFFF" Margin="0,0,6,4">
                                    <TextBlock FontSize="11">
                                        <Run Text="Risk " Foreground="{StaticResource MutedBrush}"/>
                                        <Run Text="{Binding RiskText, Mode=OneWay}" FontWeight="SemiBold"
                                             Foreground="{Binding Risk, Converter={StaticResource RiskToBrush}}"/>
                                    </TextBlock>
                                </Border>
                                <Border Style="{StaticResource Chip}" Background="#12FFFFFF" Margin="0,0,6,4">
                                    <TextBlock FontSize="11">
                                        <Run Text="Evidence " Foreground="{StaticResource MutedBrush}"/>
                                        <Run Text="{Binding EvidenceText, Mode=OneWay}" FontWeight="SemiBold"
                                             Foreground="{Binding Evidence, Converter={StaticResource EvidenceToBrush}}"/>
                                    </TextBlock>
                                </Border>
                                <Border Style="{StaticResource Chip}" Background="#1AFFBE5C" Margin="0,0,6,4"
                                        Visibility="{Binding Flags, Converter={StaticResource StringToVis}}">
                                    <TextBlock Text="{Binding Flags}" FontSize="11" Foreground="{StaticResource WarnBrush}"/>
                                </Border>
                            </WrapPanel>

                            <!-- Warnings are never hidden -->
                            <Border Margin="0,8,0,0" Padding="11,8" CornerRadius="10" Background="#14FF5D73"
                                    BorderBrush="#33FF5D73" BorderThickness="1"
                                    Visibility="{Binding HasWarning, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding Warning}" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource BadBrush}"/>
                            </Border>

                            <!-- Technical detail for enthusiasts -->
                            <Expander Header="How it works and the evidence" Margin="0,8,0,0">
                                <StackPanel Margin="17,0,0,0">
                                    <TextBlock Text="{Binding Description}" TextWrapping="Wrap" FontSize="12.5"/>
                                    <TextBlock Text="{Binding EvidenceNote}" Style="{StaticResource MutedText}" FontSize="12" Margin="0,6,0,0"
                                               Visibility="{Binding EvidenceNote, Converter={StaticResource StringToVis}}"/>
                                </StackPanel>
                            </Expander>
                        </StackPanel>

                        <Button Grid.Column="1" Content="{Binding ActionText}" MinWidth="96" Margin="16,0,0,0"
                                VerticalAlignment="Top" IsEnabled="{Binding IsNotBusy}"
                                Command="{Binding DataContext.ToggleCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource AccentButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsApplied}" Value="True">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="bd" CornerRadius="10" Background="{StaticResource HoverBrush}"
                                                                BorderBrush="{StaticResource LineHoverBrush}" BorderThickness="1" Padding="15,8">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource BadBrush}"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                </Border>
            </DataTemplate>

            <!-- ViewModel -> View mapping -->
            <DataTemplate DataType="{x:Type vm:DashboardViewModel}"><views:DashboardView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:TweaksViewModel}"><views:TweaksView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:MonitoringViewModel}"><views:MonitoringView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:ChangeLogViewModel}"><views:ChangeLogView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><views:SettingsView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:PlaceholderViewModel}"><views:PlaceholderView/></DataTemplate>

            <DataTemplate DataType="{x:Type vm:BoostCenterViewModel}"><boost:BoostCenterView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:SystemScanViewModel}"><views:SystemScanView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:CleaningViewModel}"><views:CleaningView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:StartupViewModel}"><views:StartupView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:NetworkViewModel}"><views:NetworkView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:PrivacyToolsViewModel}"><views:PrivacyToolsView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:BoosterTabViewModel}"><boost:BoosterTab/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:CpuPowerTabViewModel}"><boost:CpuPowerTab/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:TimerTabViewModel}"><boost:TimerTab/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:GpuTabViewModel}"><boost:GpuTab/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:GameConfigTabViewModel}"><boost:GameConfigTab/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:LatencyTabViewModel}"><boost:LatencyTab/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:BenchmarkTabViewModel}"><boost:BenchmarkTab/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:SessionsTabViewModel}"><boost:SessionsTab/></DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
